# Optional overrides. Copy to docker/.env (gitignored) to change host ports
# or to set INSTANCE_SECRET. Do not commit docker/.env.
#
# PORT is the self-hosted Convex backend. SITE_PROXY_PORT serves HTTP actions.
# Leave 3210 and 3211 free: those belong to `pnpm dev`.

PORT=3220
SITE_PROXY_PORT=3221
DASHBOARD_PORT=6791
INSTANCE_NAME=kura-convex
