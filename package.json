{
  "name": "kura-convex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "deploy": "convex deploy",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false && tsc -p convex --noEmit --pretty false",
    "lint": "oxlint",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "preview": "vite preview --host 127.0.0.1 --port 5175"
  },
  "dependencies": {
    "convex": "^1.48.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
